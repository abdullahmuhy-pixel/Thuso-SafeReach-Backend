# Copy this file to .env and fill in real values. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (cloud database — Task 1 requirement)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thuso_safereach

# JWT signing secret — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,https://abdullahmuhy-pixel.github.io

# Notification channel credentials (stubbed for Task 2 — real keys added when
# the group signs up for an SMS gateway / push provider)
SMS_GATEWAY_API_KEY=
PUSH_SERVICE_API_KEY=
